# Copiez ce fichier en .env et remplissez les vraies valeurs
# Ne jamais committer le fichier .env (il est dans .gitignore)

# Base de données MySQL
DB_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# Dex / OAuth2 Proxy (Kubernetes)
# Genere avec: openssl rand -base64 24 | tr -d '\n' | tr -d '='
OAUTH2_PROXY_CLIENT_SECRET=changeme

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme

# Application Laravel
APP_KEY=changeme